import json
import requests

def lambda_handler(event, context):
    # Raspberry Pi endpoint (change to your Pi's IP or domain)
    pi_url = "http://<YOUR_RPI_IP>:5000/trigger-registration"

    try:
        # Extract image key and bucket
        record = event['Records'][0]
        image_key = record['s3']['object']['key']
        bucket = record['s3']['bucket']['name']

        print(f"Triggering Pi for image: s3://{bucket}/{image_key}")

        # Send HTTP request to Raspberry Pi
        response = requests.post(pi_url, json={"bucket": bucket, "key": image_key})
        return {
            'statusCode': 200,
            'body': json.dumps(f"Triggered Raspberry Pi with image: {image_key}")
        }

    except Exception as e:
        print(f"Error: {str(e)}")
        return {
            'statusCode': 500,
            'body': json.dumps("Failed to notify Raspberry Pi.")
        }